{
  "info": {
    "name": "AccessPolicy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests01-08 individually. Mutation examples are manual; read current versions first. Set password/token privately and clear them before exporting."
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "02 Login (private password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token issued',()=>pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.environment.set('token', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('authenticated',()=>pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('ownUserId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Own organizations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/orgs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const org=pm.response.json().data.find(o=>o.slug==='atlas'); if(org) pm.environment.set('orgId',org.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Organization members",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/members?limit=20"
      }
    },
    {
      "name": "06 Own permissions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/members/{{ownUserId}}/permissions"
      }
    },
    {
      "name": "07 Audit (owner/admin only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/audit?limit=20"
      }
    },
    {
      "name": "08 Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Mutation examples (run manually after setting IDs/version)",
      "item": [
        {
          "name": "Change ordinary role (revokes target tokens)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/members/{{targetUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"viewer\",\"expectedVersion\":{{expectedVersion}}}"
            }
          }
        },
        {
          "name": "Add existing user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":{{targetUserId}},\"role\":\"member\"}"
            }
          }
        },
        {
          "name": "Remove membership (revokes target tokens)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orgs/{{orgId}}/members/{{targetUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"expectedVersion\":{{expectedVersion}}}"
            }
          }
        }
      ]
    }
  ]
}
