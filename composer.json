{
  "name": "zalamanga/accesspolicy-api",
  "description": "Organization-scoped role and permission REST API with transactional token revocation.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-pdo_pgsql": "*",
    "laravel/framework": "^12.70.2",
    "laravel/sanctum": "^4.3.3"
  },
  "require-dev": { "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "platform": { "php": "8.4.0", "ext-pdo_pgsql": "8.4.0" },
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
